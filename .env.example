# Copia este archivo a .env.local y completa los valores. Nunca commitees .env.local.

# ─── Supabase (Project Settings → API Keys) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...): pública, solo lectura gracias a RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): SOLO servidor, omite RLS
SUPABASE_SECRET_KEY=
# Para `npm run db:types` (el <project-ref> de la URL)
SUPABASE_PROJECT_ID=

# ─── Gemini (Módulo 4) · aistudio.google.com → Get API key ───────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Stellar & Passkeys (Módulo 2, Stellar Testnet) ──────────────────
# Valores públicos del despliegue de Smart Account Kit.
NEXT_PUBLIC_PASSKEY_ACCOUNT_WASM_HASH=PENDIENTE
NEXT_PUBLIC_PASSKEY_WEBAUTHN_VERIFIER_ADDRESS=PENDIENTE
# Lista separada por comas de orígenes permitidos por WebAuthn.
NEXT_PUBLIC_PASSKEY_ALLOWED_ORIGINS=http://localhost:3000

# Compatibilidad temporal con consumidores Vite previos del Módulo 2.
VITE_PASSKEY_ACCOUNT_WASM_HASH=PENDIENTE
VITE_PASSKEY_WEBAUTHN_VERIFIER_ADDRESS=PENDIENTE
VITE_PASSKEY_ALLOWED_ORIGINS=http://localhost:5173
