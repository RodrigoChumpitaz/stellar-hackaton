# Valores públicos del despliegue de Smart Account Kit en Stellar Testnet.
# Copia este archivo como .env y reemplaza PENDIENTE al desplegar Passkeys.

VITE_PASSKEY_ACCOUNT_WASM_HASH=PENDIENTE
VITE_PASSKEY_WEBAUTHN_VERIFIER_ADDRESS=PENDIENTE

# Lista separada por comas de orígenes permitidos por WebAuthn.
VITE_PASSKEY_ALLOWED_ORIGINS=http://localhost:5173
