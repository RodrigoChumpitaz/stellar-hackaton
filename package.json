{
  "name": "stellar-runes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stellar Runes: catálogo, wallet Web3, Supabase y forja Soroban.",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "npm run wallet:typecheck && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "db:seed": "tsx --env-file=.env.local scripts/seed-catalog.ts",
    "db:types": "npx supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/types/database.types.ts",
    "wallet:typecheck": "node node_modules\\deno\\bin.cjs check --sloppy-imports src/index.ts",
    "typecheck": "next typegen && tsc --noEmit && npm run wallet:typecheck"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.1.0",
    "@supabase/supabase-js": "^2.117.1",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.4.3",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "smart-account-kit": "^0.8.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "deno": "^2.6.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  }
}
